! ------------------------------------------------------------------------------
! Cursor and font rendering
! ------------------------------------------------------------------------------

! The cursor for X11 and XWayland clients, which read it from the resource
! database rather than from the compositor. It is one of several places the
! cursor is named — sway's seat, niri's cursor block and the GTK settings.ini
! files are the others — and they are held at the same theme and size on
! purpose, so the pointer does not resize as focus moves between windows.
!
! 28 is what the running session uses: sway and niri both set it, and they are
! what export XCURSOR_SIZE to everything they start.
Xcursor.theme: BreezeX-Light
Xcursor.size: 28

! Font rendering for the X11 terminals configured below. hintslight with
! subpixel order rgb is what the GTK settings.ini files ask for too.
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: rgb

! ------------------------------------------------------------------------------
! urxvt
! ------------------------------------------------------------------------------

! URxvt*cursorColor2:                   color
! URxvt*pointerColor:                   color
! URxvt*pointerColor2:                  color
! URxvt*borderColor:                    color
! URxvt*tab-bg:                         color
! URxvt*tab-fg:                         color
! URxvt*tabbar-bg:                      color
! URxvt*tabbar-fg:                      color
! URxvt*colorBD:                        color
! URxvt*colorIT:                        color
! URxvt*colorUL:                        color
! URxvt*colorRV:                        color
! URxvt*underlineColor:                 color
! URxvt*troughColor:                    color
! theme:begin urxvt
URxvt*background:                     [90]#2e3440
URxvt*foreground:                     #eceff4
URxvt*cursorColor:                    #8fbcbb
URxvt*scrollColor:                    #eceff4
URxvt*highlightColor:                 #3b4252
URxvt*highlightTextColor:             #eceff4

URxvt*color0:                         #3b4252
URxvt*color1:                         #bf616a
URxvt*color2:                         #a3be8c
URxvt*color3:                         #ebcb8b
URxvt*color4:                         #81a1c1
URxvt*color5:                         #b48ead
URxvt*color6:                         #88c0d0
URxvt*color7:                         #e5e9f0
URxvt*color8:                         #4c566a
URxvt*color9:                         #bf616a
URxvt*color10:                        #a3be8c
URxvt*color11:                        #ebcb8b
URxvt*color12:                        #81a1c1
URxvt*color13:                        #b48ead
URxvt*color14:                        #8fbcbb
URxvt*color15:                        #eceff4
! theme:end

! plugins
URxvt.perl-ext-common: default,matcher,resize-font,fullscreen
URxvt.url-launcher: /usr/bin/xdg-open
URxvt.matcher.button: 1
URxvt.keysym.F11: perl:fullscreen:switch
URxvt.iso14755: false
URxvt.iso14755_52: false

! settings
URxvt.urgentOnBell: true
URxvt.scrollBar: false
URxvt.letterSpace: 0
! theme:begin urxvt-font
URxvt.font: xft:JetBrainsMonoNL NF:size=14, xft:DejaVu Sans Mono Nerd Font:size=14, xft:DejaVu Sans:size=14
! theme:end
URxvt.depth: 32

!bindings for arrow moves
URxvt.keysym.Control-Up:     \033[1;5A
URxvt.keysym.Control-Down:   \033[1;5B
URxvt.keysym.Control-Left:   \033[1;5D
URxvt.keysym.Control-Right:  \033[1;5C

! ------------------------------------------------------------------------------
! Rofi and dmenu configs
! ------------------------------------------------------------------------------

! theme:begin xmenus
rofi.color-enabled: true
rofi.color-window: #2e3440, #88c0d0, #2e3440
rofi.color-normal: #2e3440, #eceff4, #2e3440, #3b4252, #8fbcbb
rofi.color-active: #2e3440, #81a1c1, #2e3440, #3b4252, #81a1c1
rofi.color-urgent: #2e3440, #bf616a, #2e3440, #3b4252, #bf616a
rofi.modi: run,drun,window

dmenu.selforeground:	    #2e3440
dmenu.background:	        #2e3440
dmenu.selbackground:	    #8fbcbb
dmenu.foreground:	        #eceff4
! theme:end

