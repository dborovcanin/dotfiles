# GTK 2 — goes to ~/.gtkrc-2.0.mine.
#
# ~/.gtkrc-2.0 carries a "DO NOT EDIT" header because LXAppearance rewrites it,
# but it includes this file, so gruvbox lives here and survives.
#
# GTK 2 engines bake a lot of their colours in, so this is as close as GTK 2
# gets. Breeze is the base because it ships both a light and a dark variant and
# is already installed; theme.sh picks the one matching THEME_SCHEME.

# theme:begin gtk2-theme
gtk-theme-name = "Breeze-Dark"
# theme:end
gtk-icon-theme-name = "Adwaita"

# theme:begin gtk2
gtk_color_scheme = "fg_color:#eceff4\nbg_color:#2e3440\nbase_color:#2e3440\ntext_color:#eceff4\nselected_fg_color:#2e3440\nselected_bg_color:#88c0d0\ntooltip_fg_color:#eceff4\ntooltip_bg_color:#3b4252"

style "gruvbox-default" {
    fg[NORMAL]        = "#eceff4"
    fg[PRELIGHT]      = "#eceff4"
    fg[SELECTED]      = "#2e3440"
    fg[ACTIVE]        = "#eceff4"
    fg[INSENSITIVE]   = "#7b88a1"
    bg[NORMAL]        = "#2e3440"
    bg[PRELIGHT]      = "#3b4252"
    bg[SELECTED]      = "#88c0d0"
    bg[ACTIVE]        = "#3b4252"
    bg[INSENSITIVE]   = "#2e3440"
    base[NORMAL]      = "#2e3440"
    base[PRELIGHT]    = "#3b4252"
    base[SELECTED]    = "#88c0d0"
    base[ACTIVE]      = "#434c5e"
    base[INSENSITIVE] = "#2e3440"
    text[NORMAL]      = "#eceff4"
    text[PRELIGHT]    = "#eceff4"
    text[SELECTED]    = "#2e3440"
    text[ACTIVE]      = "#eceff4"
    text[INSENSITIVE] = "#7b88a1"
}

class "GtkWidget" style "gruvbox-default"
# theme:end
