# Ghostty rereads this file on SIGUSR2, which install.sh sends it; ctrl+shift+,
# does the same from the keyboard. It does not watch the file the way alacritty
# and kitty do.

term = xterm-256color

# theme:begin ghostty-font
font-family = JetBrainsMonoNL NF
font-size = 14
# theme:end

window-padding-x = 2
window-padding-y = 2
# theme:begin ghostty-opacity
background-opacity = 0.9
# theme:end
background-blur = true

cursor-style = bar
cursor-style-blink = false

# Ghostty counts scrollback in bytes rather than lines, so this is not the
# 250000 lines the other terminals are given: 100 MB is the same order of
# history for the same kind of output.
scrollback-limit = 100000000

# One process for every window: the first ghostty starts it, and every later
# `ghostty` hands its window to that one instead of starting a second. Left at
# the default (`detect`) only a launch from the desktop file would do this, and
# one from a keybinding or a shell would not. Windows are cheap this way, the
# way footclient's are against `foot --server`, and closing the last one still
# ends the process.
gtk-single-instance = true
gtk-titlebar = false

keybind = f11=toggle_fullscreen
keybind = ctrl+shift+enter=new_window

# Colors, written by scripts/theme.sh

# theme:begin ghostty
background = #2e3440
foreground = #eceff4

cursor-color = #8fbcbb
cursor-text = #2e3440

selection-foreground = #eceff4
selection-background = #3b4252

palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0

palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4
# theme:end
