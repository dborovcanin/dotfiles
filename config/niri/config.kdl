// Niri config, ported from config/sway/config.
// https://yalter.github.io/niri/Configuration:-Introduction
//
// Sway features with no niri equivalent are noted inline: sticky windows,
// binding modes, runtime gaps, parent focus and per-window idle inhibit.
// Scratchpad, urgent focus, system menu and the sway-specific scripts are
// replaced by scripts in scripts/niri.

// Colours are written by scripts/theme.sh between the theme markers.

environment {
    GTK_THEME "Adwaita"
    GTK2_RC_FILES "/home/dusan/.gtkrc-2.0"
    XDG_CURRENT_DESKTOP "niri"
}

cursor {
    xcursor-theme "BreezeX-Light"
    xcursor-size 28
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "/tmp/screenshots/screenshot-%Y-%m-%d_%H-%M-%S.png"

input {
    keyboard {
        xkb {
            layout "us,rs,rs"
            variant ",latin,"
            options "grp:alt_shift_toggle"
        }
    }

    touchpad {
        tap
        dwt
        dwtp
        tap-button-map "left-right-middle"
        middle-emulation
    }
}

output "eDP-1" {
    mode "1920x1200"
    scale 1
    position x=0 y=0
}

output "DP-1" {
    scale 1
    transform "normal"
    position x=1920 y=0
}

output "HDMI-A-1" {
    scale 1
    position x=1920 y=0
}

layout {
    gaps 15
    center-focused-column "never"
    // theme:begin niri-background
    background-color "#282828"
    // theme:end

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 5
        // theme:begin niri-border
        active-color "#d79921"
        inactive-color "#3c3836"
        urgent-color "#cc241d"
        // theme:end
    }

    tab-indicator {
        // theme:begin niri-tabs
        active-color "#d79921"
        inactive-color "#928374"
        urgent-color "#cc241d"
        // theme:end
    }
}

blur {
    passes 1
    offset 8
    noise 0.02
}

// Slight rounded corners + blur behind translucent windows
window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
    background-effect {
        blur true
    }
}

// Startup
spawn-sh-at-startup "swaybg -i /home/dusan/Pictures/backgrounds/gruvbox-wallpapers/wallpapers/mix/Powerline.png -m fill"
// niri draws bottom-layer surfaces inside each workspace, so they slide on a
// switch. Run dbar on the top layer here to keep it fixed; sway keeps "bottom".
spawn-sh-at-startup r#"sed 's/^layer = "bottom"$/layer = "top"/' $HOME/dotfiles/config/dbar/config.toml > $XDG_RUNTIME_DIR/dbar-niri.toml && dbar -c $XDG_RUNTIME_DIR/dbar-niri.toml"#
spawn-sh-at-startup "xrdb -merge ~/.Xresources"
spawn-sh-at-startup "dunst -config $HOME/dotfiles/config/dunst/dunstrc > /dev/null"
spawn-sh-at-startup "$HOME/dotfiles/scripts/startup.sh > /dev/null"
spawn-sh-at-startup "foot --server"
spawn-sh-at-startup "kdeconnectd > /dev/null"
spawn-sh-at-startup "wl-paste --watch cliphist store --max-items=5000"
spawn-sh-at-startup "swayidle -w timeout 300 'pgrep -x swaylock >/dev/null || swaylock -f -i /home/dusan/Pictures/backgrounds/gruvbox-wallpapers/wallpapers/mix/Powerline-blur.png' timeout 600 'niri msg action power-off-monitors' before-sleep 'pgrep -x swaylock >/dev/null || swaylock -f -i /home/dusan/Pictures/backgrounds/gruvbox-wallpapers/wallpapers/mix/Powerline-blur.png'"

// Named workspaces, so windows can be assigned to them like in sway
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "0"
workspace "scratch"

// Assign windows to workspaces
window-rule {
    match app-id=r#"(?i)^slack$"#
    open-on-workspace "1"
}

window-rule {
    match app-id=r#"(?i)^(code|code-oss|codium|vscodium)$"#
    open-on-workspace "2"
}

window-rule {
    match app-id=r#"^brave-browser$"#
    open-on-workspace "3"
}

window-rule {
    match app-id=r#"^Postman$"#
    open-on-workspace "4"
}

window-rule {
    match app-id=r#"^zoom$"#
    open-on-workspace "6"
}

// Floating windows
window-rule {
    match app-id=r#"^(float_term|sticky_term)$"#
    open-floating true
    default-column-width { fixed 1400; }
    default-window-height { fixed 1000; }
}

window-rule {
    match app-id=r#"^(content-search|file-search)$"#
    open-floating true
    default-column-width { fixed 1500; }
    default-window-height { fixed 950; }
}

window-rule {
    match app-id=r#"^slight$"#
    open-floating true
    default-column-width { fixed 1400; }
    default-window-height { fixed 950; }
}

window-rule {
    match app-id=r#"^system-monitor$"#
    open-floating true
    default-column-width { fixed 1800; }
    default-window-height { fixed 900; }
}

window-rule {
    match app-id=r#"^(satty|feh|fzf-menu)$"#
    open-floating true
    open-focused true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Terminals (niri has no sticky windows; sticky_term is only floating)
    Mod+Return { spawn "footclient" "-T" "term"; }
    Mod+Shift+Return { spawn "footclient" "-T" "term" "--app-id" "float_term"; }
    Mod+Ctrl+Shift+Return { spawn "footclient" "--app-id" "sticky_term"; }

    // Displays
    Mod+P { spawn "niri" "msg" "output" "eDP-1" "on"; }
    Mod+Ctrl+P { spawn "niri" "msg" "output" "DP-1" "on"; }
    Mod+Shift+P { spawn "niri" "msg" "output" "eDP-1" "off"; }
    Mod+Ctrl+Shift+P { spawn "niri" "msg" "output" "DP-1" "off"; }

    Mod+Shift+Q repeat=false { close-window; }

    // Launcher
    Mod+D { spawn-sh "$HOME/dotfiles/scripts/launcher.sh"; }

    // Focus
    Mod+J     { focus-column-left; }
    Mod+K     { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    // Move
    Mod+Shift+J         { move-column-left; }
    Mod+Shift+K         { move-window-down; }
    Mod+Shift+L         { move-window-up; }
    Mod+Shift+Semicolon { move-column-right; }
    Mod+Shift+Left      { move-column-left; }
    Mod+Shift+Down      { move-window-down; }
    Mod+Shift+Up        { move-window-up; }
    Mod+Shift+Right     { move-column-right; }

    // Closest thing to split h / split v: pull windows out of or into a column
    Mod+H { expel-window-from-column; }
    Mod+V { consume-window-into-column; }

    Mod+F { fullscreen-window; }
    Mod+Alt+F { maximize-column; }
    Mod+W { toggle-column-tabbed-display; }

    Mod+T     { toggle-window-floating; }
    Mod+Space { switch-focus-between-floating-and-tiling; }

    // Resize (no binding modes in niri)
    Mod+R             { switch-preset-column-width; }
    Mod+Minus         { set-column-width "-10%"; }
    Mod+Equal         { set-column-width "+10%"; }
    Mod+Shift+Minus   { set-window-height "-10%"; }
    Mod+Shift+Equal   { set-window-height "+10%"; }
    Mod+Ctrl+R        { reset-window-height; }

    // Workspaces
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+6 { focus-workspace "6"; }
    Mod+7 { focus-workspace "7"; }
    Mod+8 { focus-workspace "8"; }
    Mod+9 { focus-workspace "9"; }
    Mod+0 { focus-workspace "0"; }

    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }
    Mod+Shift+6 { move-column-to-workspace "6"; }
    Mod+Shift+7 { move-column-to-workspace "7"; }
    Mod+Shift+8 { move-column-to-workspace "8"; }
    Mod+Shift+9 { move-column-to-workspace "9"; }
    Mod+Shift+0 { move-column-to-workspace "0"; }

    // Move workspace to another output (replaces sway's move_workspace mode)
    Mod+Ctrl+Shift+Left  { move-workspace-to-monitor-left; }
    Mod+Ctrl+Shift+Down  { move-workspace-to-monitor-down; }
    Mod+Ctrl+Shift+Up    { move-workspace-to-monitor-up; }
    Mod+Ctrl+Shift+Right { move-workspace-to-monitor-right; }

    // Exit (niri shows its own confirmation dialog)
    Mod+Shift+E { quit; }

    // Power menu (shared with sway and i3)
    Mod+Escape { spawn-sh "$HOME/dotfiles/scripts/power.sh"; }

    // Scratchpad (scripted, windows park on the "scratch" workspace)
    Mod+Shift+M { spawn-sh "$HOME/dotfiles/scripts/niri/scratchpad.sh move"; }
    Mod+M { spawn-sh "$HOME/dotfiles/scripts/niri/scratchpad.sh show"; }

    // Focus urgent window
    Mod+X { spawn-sh "$HOME/dotfiles/scripts/niri/focus_urgent.sh"; }

    // Brightness and audio
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "$HOME/dotfiles/scripts/brightness.sh up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "$HOME/dotfiles/scripts/brightness.sh down"; }
    Shift+XF86MonBrightnessUp allow-when-locked=true { spawn "ddcutil" "setvcp" "10" "+" "5"; }
    Shift+XF86MonBrightnessDown allow-when-locked=true { spawn "ddcutil" "setvcp" "10" "-" "5"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "+5%"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "-5%"; }
    XF86AudioMute allow-when-locked=true { spawn "pactl" "set-sink-mute" "@DEFAULT_SINK@" "toggle"; }

    // Tools
    Mod+E { spawn-sh "$HOME/dotfiles/scripts/emoji.sh"; }
    Mod+Shift+F { spawn-sh "footclient --app-id content-search sh -c $HOME/dotfiles/scripts/content_search.sh"; }
    Mod+Ctrl+F { spawn-sh "footclient --app-id file-search sh -c $HOME/dotfiles/bin/search"; }
    Mod+N { spawn "footclient" "-w" "1400x950" "--app-id" "slight" "/home/dusan/.local/bin/slight"; }
    Mod+B { spawn "footclient" "--app-id" "system-monitor" "btop"; }
    Mod+Shift+C { spawn-sh "codium $HOME/dotfiles"; }
    Mod+C { spawn-sh "$HOME/dotfiles/scripts/clipboard.sh"; }
    Mod+G { spawn-sh "brave > /dev/null"; }
    Mod+Shift+S { spawn-sh "$HOME/dotfiles/scripts/screenshot.sh"; }

    // Notifications
    Ctrl+Space { spawn "dunstctl" "close"; }
    Ctrl+Shift+Space { spawn "dunstctl" "close-all"; }
    Alt+Grave { spawn "dunstctl" "history-pop"; }
    Ctrl+Shift+Period { spawn "dunstctl" "context"; }

    // Overview, niri's way to see all workspaces
    Mod+Tab repeat=false { toggle-overview; }
}
