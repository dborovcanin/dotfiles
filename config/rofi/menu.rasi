/*
 * The list menus - scripts/launcher.sh, scripts/clipboard.sh and
 * scripts/share.sh - drawn like the tiles of scripts/power.sh: one rounded
 * frame in the middle of the screen, and the row under the cursor raised with
 * a frame of its own.
 *
 * The colours are written by scripts/theme.sh between the theme markers, and
 * so are the fonts and the metrics below them: @bw, @radius and @radius-item
 * are named once and referred to everywhere a frame or a corner is drawn, so
 * that a border width lives in themes/style.sh rather than at six places here.
 */

* {
    /* theme:begin rofi */
    bg: #2e3440;
    bg-alt: #3b4252;
    fg: #eceff4;
    fg-alt: #e5e9f0;
    dim: #7b88a1;
    frame: #88c0d0;
    accent: #8fbcbb;
    urgent: #bf616a;
    /* theme:end */

    /* theme:begin rofi-metrics */
    font-main: "JetBrainsMonoNL NF 14";
    font-prompt: "JetBrainsMonoNL NFP 18";
    bw: 4px solid;
    radius: 16px;
    radius-item: 12px;
    /* theme:end */

    font: @font-main;
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 20em;
    background-color: @bg;
    border: @bw;
    border-color: @frame;
    border-radius: @radius;
    padding: 24px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 16px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 14px;
    padding: 12px 16px;
    background-color: @bg-alt;
    border-radius: @radius-item;
}

prompt {
    /* Propo: the mono font squeezes icons into one cell and rofi clips the rest. */
    font: @font-prompt;
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search";
    placeholder-color: @dim;
    cursor: text;
    vertical-align: 0.5;
}

message {
    padding: 0 4px;
}

textbox {
    text-color: @dim;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    spacing: 6px;
    scrollbar: false;
    cycle: true;
}

element {
    padding: 10px 14px;
    spacing: 14px;
    border: @bw;
    border-radius: @radius-item;
    border-color: transparent;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}

element selected.normal, element selected.active {
    background-color: @bg-alt;
    border-color: @accent;
    text-color: @fg;
}

element selected.urgent {
    background-color: @bg-alt;
    border-color: @urgent;
    text-color: @urgent;
}

element-icon {
    size: 1.4em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
