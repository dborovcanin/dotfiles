/*
 * The list menus - scripts/launcher.sh and scripts/clipboard.sh - drawn
 * like the tiles of scripts/power.sh: one rounded frame in the middle of the
 * screen, and the row under the cursor raised with a frame of its own.
 *
 * The colours are written by scripts/theme.sh between the theme markers.
 */

* {
    /* theme:begin rofi */
    bg: #282828;
    bg-alt: #3c3836;
    fg: #ebdbb2;
    fg-alt: #d5c4a1;
    dim: #928374;
    frame: #d79921;
    accent: #fabd2f;
    urgent: #fb4934;
    /* theme:end */

    font: "JetBrainsMonoNL NF 14";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 44em;
    background-color: @bg;
    border: 2px solid;
    border-color: @frame;
    border-radius: 16px;
    padding: 24px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 16px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 14px;
    padding: 12px 16px;
    background-color: @bg-alt;
    border-radius: 12px;
}

prompt {
    /* Propo: the mono font squeezes icons into one cell and rofi clips the rest. */
    font: "JetBrainsMonoNL NFP 18";
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search";
    placeholder-color: @dim;
    cursor: text;
    vertical-align: 0.5;
}

message {
    padding: 0 4px;
}

textbox {
    text-color: @dim;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    spacing: 6px;
    scrollbar: false;
    cycle: true;
}

element {
    padding: 10px 14px;
    spacing: 14px;
    border: 2px solid;
    border-radius: 12px;
    border-color: transparent;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}

element selected.normal, element selected.active {
    background-color: @bg-alt;
    border-color: @accent;
    text-color: @fg;
}

element selected.urgent {
    background-color: @bg-alt;
    border-color: @urgent;
    text-color: @urgent;
}

element-icon {
    size: 1.4em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
