# The dotfiles palette as a btop theme. Written by scripts/theme.sh - edit the
# render_btop block there, not this file.
#
# btop draws a meter as a gradient between start, mid and end, and treats an
# empty mid and end as a single flat colour, which is what the memory and
# network meters get: they measure how much, not how bad.

# theme:begin btop
theme[main_bg]="#282828"
theme[main_fg]="#ebdbb2"
theme[title]="#ebdbb2"
theme[hi_fg]="#d79921"
theme[selected_bg]="#504945"
theme[selected_fg]="#ebdbb2"
theme[inactive_fg]="#928374"
theme[graph_text]="#a89984"
theme[proc_misc]="#fabd2f"
theme[cpu_box]="#504945"
theme[mem_box]="#504945"
theme[net_box]="#504945"
theme[proc_box]="#504945"
theme[div_line]="#504945"
theme[temp_start]="#8ec07c"
theme[temp_mid]="#fe8019"
theme[temp_end]="#fb4934"
theme[cpu_start]="#b8bb26"
theme[cpu_mid]="#fabd2f"
theme[cpu_end]="#fb4934"
theme[free_start]="#b8bb26"
theme[free_mid]=""
theme[free_end]=""
theme[cached_start]="#8ec07c"
theme[cached_mid]=""
theme[cached_end]=""
theme[available_start]="#fabd2f"
theme[available_mid]=""
theme[available_end]=""
theme[used_start]="#fb4934"
theme[used_mid]=""
theme[used_end]=""
theme[download_start]="#83a598"
theme[download_mid]=""
theme[download_end]=""
theme[upload_start]="#d3869b"
theme[upload_mid]=""
theme[upload_end]=""
# theme:end
