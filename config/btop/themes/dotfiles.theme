# The dotfiles palette as a btop theme. Written by scripts/theme.sh - edit the
# render_btop block there, not this file.
#
# btop draws a meter as a gradient between start, mid and end, and treats an
# empty mid and end as a single flat colour, which is what the memory and
# network meters get: they measure how much, not how bad.

# theme:begin btop
theme[main_bg]="#2e3440"
theme[main_fg]="#eceff4"
theme[title]="#eceff4"
theme[hi_fg]="#88c0d0"
theme[selected_bg]="#434c5e"
theme[selected_fg]="#eceff4"
theme[inactive_fg]="#7b88a1"
theme[graph_text]="#d8dee9"
theme[proc_misc]="#8fbcbb"
theme[cpu_box]="#434c5e"
theme[mem_box]="#434c5e"
theme[net_box]="#434c5e"
theme[proc_box]="#434c5e"
theme[div_line]="#434c5e"
theme[temp_start]="#88c0d0"
theme[temp_mid]="#d08770"
theme[temp_end]="#bf616a"
theme[cpu_start]="#a3be8c"
theme[cpu_mid]="#ebcb8b"
theme[cpu_end]="#bf616a"
theme[free_start]="#a3be8c"
theme[free_mid]=""
theme[free_end]=""
theme[cached_start]="#88c0d0"
theme[cached_mid]=""
theme[cached_end]=""
theme[available_start]="#ebcb8b"
theme[available_mid]=""
theme[available_end]=""
theme[used_start]="#bf616a"
theme[used_mid]=""
theme[used_end]=""
theme[download_start]="#81a1c1"
theme[download_mid]=""
theme[download_end]=""
theme[upload_start]="#b48ead"
theme[upload_mid]=""
theme[upload_end]=""
# theme:end
