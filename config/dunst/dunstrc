
[global]
    # On Wayland, the compositor chooses the output for mouse/keyboard follow.
    follow = mouse
    # Invoke the notification's default action (e.g. open the Slack discussion).
    mouse_left_click = do_action, close_current
    indicate_hidden = yes
    # Hide the (A)/(U)/(AU) actions and URLs markers dunst prepends to summaries.
    # Purely cosmetic: mouse_left_click still triggers the default action.
    show_indicators = no
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    # theme:begin dunst-geometry
    frame_width = 4
    corner_radius = 10
    transparency = 0
    # theme:end
    # theme:begin dunst-global
    frame_color = "#88c0d0"
    separator_color = "#434c5e"
    # theme:end
    close = ctrl+space
    close_all = ctrl+shift+space
    history = mod1+grave
    context = ctrl+shift+period
    origin = top-center
    enable_recursive_icon_lookup = false
#   max_icon_size = 64
#   icon_position = off
    icon_theme = Papirus
    icon_path = /usr/share/icons/Papirus/16x16/status:/usr/share/icons/Papirus/16x16/devices:/usr/share/icons/hicolor/48x48/apps
    enable_recursive_icon_lookup = true


# Sort messages by urgency
    sort = yes
    gap_size = 10

    title = Dunst
    class = Dunst

    idle_threshold = 120
    # theme:begin dunst-font
    font = JetBrainsMonoNL NF 14
    # theme:end

# theme:begin dunst-urgency
[urgency_low]
    background = "#2e3440"
    foreground = "#d8dee9"
    timeout = 20

[urgency_normal]
    background = "#2e3440"
    foreground = "#eceff4"
    timeout = 20

[urgency_critical]
    background = "#2e3440"
    foreground = "#eceff4"
    frame_color = "#bf616a"
    timeout = 0
# theme:end

[slack]
    appname = Slack
    new_icon = slack
