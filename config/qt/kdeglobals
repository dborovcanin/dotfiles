# KDE / KFramework apps — okular, kdenlive, kdeconnect, kwave and the rest.
#
# Goes to ~/.config/kdeglobals. These apps use the Breeze style, which builds
# its own palette out of the sections below and ignores QT_QPA_PLATFORMTHEME,
# so they need this file on top of the Qt palette that other Qt apps take from
# GTK. Colours are "r,g,b" decimals and are written by scripts/theme.sh.
#
# The fonts in [General] come from themes/style.sh, because these apps read
# their font from here rather than from GTK.
#
# The settings outside the colour block are the file-dialog preferences that
# were already here; KDE rewrites them as you use its dialogs.

[KFileDialog Settings]
Allow Expansion=false
Automatically select filename extension=true
Breadcrumb Navigation=true
Decoration position=2
Show Full Path=false
Show Inline Previews=true
Show Speedbar=true
Show hidden files=false
Sort by=Name
Sort directories first=true
Sort hidden files last=false
Sort reversed=false
Speedbar Width=137
View Style=DetailTree

[PreviewSettings]
MaximumRemoteSize=0

# theme:begin kde-globals
