# The KDE colour scheme, goes to ~/.local/share/color-schemes/Dotfiles.colors.
#
# kdeglobals names this scheme, and KDE apps resolve that name against the
# scheme files in this directory and in /usr/share/color-schemes. Without a
# file to resolve to they fall back to Breeze, which is what makes an otherwise
# correct kdeglobals look like it is being ignored.
#
# Same colours as the block in config/qt/kdeglobals; both are written by
# scripts/theme.sh from the one block.

# theme:begin kde
[General]
Name=Dotfiles
ColorScheme=Dotfiles
AccentColor=215,153,33

[Colors:Window]
BackgroundNormal=40,40,40
BackgroundAlternate=60,56,54
ForegroundNormal=235,219,178
ForegroundInactive=146,131,116
ForegroundActive=250,189,47
ForegroundLink=131,165,152
ForegroundVisited=211,134,155
ForegroundNegative=251,73,52
ForegroundNeutral=250,189,47
ForegroundPositive=184,187,38
DecorationFocus=215,153,33
DecorationHover=215,153,33

[Colors:View]
